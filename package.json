{
  "name": "synthstudio",
  "version": "3.302.0",
  "type": "module",
  "license": "MIT",
  "main": "electron-dist/main.cjs",
  "scripts": {
    "license:keygen": "node scripts/license-keygen.mjs",
    "gen:sandbox": "node scripts/generate-sandbox-source.mjs",
    "predev": "pnpm gen:sandbox",
    "prebuild": "pnpm gen:sandbox",
    "precheck": "pnpm gen:sandbox",
    "pretest": "pnpm gen:sandbox",
    "dev": "cross-env NODE_ENV=development vite",
    "dev:electron": "concurrently \"pnpm dev\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "vite build",
    "build:electron": "vite build && electron-builder",
    "prebuild:electron:win": "node scripts/clean-release.cjs",
    "build:electron:win": "vite build && pnpm compile:electron && electron-builder --win",
    "build:electron:mac": "vite build && pnpm compile:electron && electron-builder --mac",
    "build:electron:linux": "vite build && pnpm compile:electron && electron-builder --linux",
    "compile:electron": "tsc --project tsconfig.electron.json && node scripts/rename-to-cjs.cjs && esbuild electron/collab-server.ts --bundle --platform=node --format=cjs --external:bufferutil --external:utf-8-validate --outfile=electron-dist/collab-server.cjs && esbuild electron/updater.ts --bundle --platform=node --format=cjs --external:electron --outfile=electron-dist/updater.cjs",
    "generate:icons": "npx tsx electron/assets/create-icons.ts",
    "start": "cross-env NODE_ENV=production vite preview --outDir dist/public",
    "start:electron": "electron .",
    "check": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:features": "vitest run tests/features",
    "test:all": "pnpm check && pnpm test && pnpm test:web",
    "test:e2e": "playwright test",
    "test:web": "playwright test --config=playwright.web.config.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "db:push": "drizzle-kit generate && drizzle-kit migrate",
    "release": "pnpm build:electron --publish always"
  },
  "dependencies": {
    "@noble/ed25519": "^3.1.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.15",
    "@types/ws": "^8.18.1",
    "clsx": "^2.1.1",
    "dockview-react": "^6.4.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.453.0",
    "nanoid": "^5.1.11",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "recharts": "^2.15.4",
    "tailwind-merge": "^3.6.0",
    "tone": "^15.1.22",
    "ws": "^8.21.0",
    "zod": "^4.4.3",
    "@julusian/midi": "^3.6.1"
  },
  "devDependencies": {
    "@builder.io/vite-plugin-jsx-loc": "^0.1.1",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/react": "^16.3.2",
    "@types/express": "4.17.21",
    "@types/node": "^24.12.4",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.5.0",
    "canvas": "^3.2.3",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.10",
    "electron": "^40.10.1",
    "electron-builder": "^26.8.1",
    "electron-updater": "^6.8.3",
    "esbuild": "^0.25.12",
    "jsdom": "^29.1.1",
    "playwright": "^1.60.0",
    "png-to-ico": "^3.0.1",
    "pnpm": "^10.33.4",
    "postcss": "^8.5.15",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.22.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "^7.3.3",
    "vite-plugin-manus-runtime": "^0.0.57",
    "vitest": "^2.1.9",
    "wait-on": "^9.0.10"
  },
  "packageManager": "pnpm@10.4.1+sha512.c753b6c3ad7afa13af388fa6d808035a008e30ea9993f58c6663e2bc5ff21679aa834db094987129aa4d488b86df57f7b634981b2f827cdcacc698cc0cfb88af",
  "pnpm": {
    "overrides": {
      "tailwindcss>nanoid": "3.3.7"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "electron",
      "@tailwindcss/oxide",
      "@julusian/midi"
    ]
  },
  "build": {
    "appId": "com.synthstudio.app",
    "productName": "Synthstudio",
    "copyright": "Copyright © 2025 Synthstudio",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "warningsAsErrors": false,
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Synthstudio",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "installerLanguages": [
        "de_DE",
        "en_US"
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.icns",
      "category": "public.app-category.music",
      "darkModeSupport": true,
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "assets/entitlements.mac.plist",
      "entitlementsInherit": "assets/entitlements.mac.plist"
    },
    "dmg": {
      "title": "Synthstudio ${version}",
      "icon": "assets/icon.icns",
      "background": "assets/dmg-background.png",
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 130,
          "y": 220,
          "type": "file"
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "Audio",
      "synopsis": "Professioneller Sample-Synthesizer und Drum Machine",
      "description": "Synthstudio – Professioneller Sample-Synthesizer und Drum Machine"
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1"
      ],
      "recommends": [
        "libappindicator3-1"
      ],
      "maintainer": "GeorgDub <synthstudio@example.com>"
    },
    "publish": {
      "provider": "github",
      "owner": "GeorgDub",
      "repo": "Synthstudio-releases",
      "releaseType": "draft"
    },
    "asar": false,
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "extraMetadata": {
      "dependencies": {}
    },
    "files": [
      "package.json",
      {
        "from": "electron-dist",
        "to": "electron-dist",
        "filter": [
          "**/*.cjs",
          "**/*.json"
        ]
      },
      {
        "from": "dist/public",
        "to": "dist/public",
        "filter": [
          "**/*",
          "!**/*.map"
        ]
      },
      "!node_modules/**/*",
      "!**/node_modules/**/*",
      "node_modules/@julusian/**/*",
      "node_modules/pkg-prebuilds/**/*"
    ],
    "buildVersion": "1.7.0"
  },
  "author": {
    "name": "GeorgDub",
    "email": "synthstudio@example.com"
  },
  "description": "Professioneller Sample-Synthesizer und Drum Machine"
}

exports[`CSP — Snapshot (verhindert unbeabsichtigte Änderungen) > Development-CSP-Header-Snapshot 1`] = `"default-src 'self'; script-src 'self' http://localhost:* http://127.0.0.1:*; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: http://localhost:* http://127.0.0.1:*; media-src 'self' blob: file: http://localhost:* http://127.0.0.1:*; font-src 'self' data:; worker-src 'self' blob:; connect-src 'self' blob: data: ws: wss: http://localhost:* http://127.0.0.1:* ws://localhost:* ws://127.0.0.1:* https://api.openai.com https://api.anthropic.com; object-src 'none'; base-uri 'self'; form-action 'self'"`;

exports[`CSP — Snapshot (verhindert unbeabsichtigte Änderungen) > Production-CSP-Header-Snapshot 1`] = `"default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob: file:; font-src 'self' data:; worker-src 'self' blob:; connect-src 'self' blob: data: ws: wss: https://api.openai.com https://api.anthropic.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"`;
